{
  "name": "@pkg/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./button": {
      "types": "./src/button.ts",
      "import": "./src/button.ts"
    },
    "./dialog": {
      "types": "./src/dialog.ts",
      "import": "./src/dialog.ts"
    },
    "./input": {
      "types": "./src/input.ts",
      "import": "./src/input.ts"
    },
    "./input-group": {
      "types": "./src/input-group.ts",
      "import": "./src/input-group.ts"
    },
    "./combobox": {
      "types": "./src/combobox.ts",
      "import": "./src/combobox.ts"
    },
    "./typography": {
      "types": "./src/typography.ts",
      "import": "./src/typography.ts"
    },
    "./surface": {
      "types": "./src/surface.ts",
      "import": "./src/surface.ts"
    },
    "./separator": {
      "types": "./src/separator.ts",
      "import": "./src/separator.ts"
    },
    "./primitives/button": {
      "types": "./src/primitives/button.ts",
      "import": "./src/primitives/button.ts"
    },
    "./primitives/dialog": {
      "types": "./src/primitives/dialog.ts",
      "import": "./src/primitives/dialog.ts"
    },
    "./styles.css": "./src/styles.css",
    "./styles/base.css": "./src/styles/base.css",
    "./styles/button.css": "./src/styles/button.css",
    "./styles/dialog.css": "./src/styles/dialog.css",
    "./styles/input.css": "./src/styles/input.css",
    "./styles/input-group.css": "./src/styles/input-group.css",
    "./styles/combobox.css": "./src/styles/combobox.css",
    "./styles/typography.css": "./src/styles/typography.css",
    "./styles/surface.css": "./src/styles/surface.css",
    "./styles/separator.css": "./src/styles/separator.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@heroui/styles": "catalog:"
  },
  "devDependencies": {
    "@foldkit/ui": "catalog:",
    "effect": "catalog:",
    "foldkit": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@foldkit/ui": "catalog:",
    "effect": "catalog:",
    "foldkit": "catalog:"
  }
}
