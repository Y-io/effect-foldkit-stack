{
  "name": "effect-foldkit-stack",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --config oxlint.config.ts .",
    "lint:fix": "oxlint --config oxlint.config.ts --fix .",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "dependencies": {
    "@effect/platform-browser": "catalog:",
    "@effect/platform-node": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@foldkit/oxlint-plugin": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "26.7.0",
    "pnpm": "11.20.0"
  },
  "packageManager": "pnpm@11.20.0"
}
